class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        
        // Если нам вообще ничего не дали, то и возвращать нечего
        if (strs.empty()) {
            return "";
        }

        // Берём первую строку за основу — с ней будем сравнивать все остальные
        string firstString = strs[0];

        // Сюда будем складывать совпадающие буквы
        string commonPrefix = "";

        // Проходим по каждой букве первой строки по очереди
        for (int i = 0; i < firstString.length(); i++) {

            // Текущая буква из первой строки (образец)
            char currentLetter = firstString[i];

            // Теперь сравниваем эту букву с такими же по счёту буквами
            // во всех остальных строках. Начинаем с первой строки (индекс 1),
            // потому что нулевую мы уже взяли как образец.
            for (int j = 1; j < strs.size(); j++) {

                // Берём очередную строку для сравнения
                string otherString = strs[j];

                // Если у другой строки нет такой буквы (она короче)
                // или её буква не совпадает с нашей значит, общий префикс закончился.
                // Возвращаем то, что уже нашли.
                if (i >= otherString.length() || otherString[i] != currentLetter) {
                    return commonPrefix;
                }
            }

            // Если все строки прошли проверку и буквы совпали —
            // добавляем текущую букву к нашему общему префиксу.
            commonPrefix = commonPrefix + currentLetter;
        }

        // Если дошли до конца первой строки, значит, она вся целиком
        // является общим префиксом для всех строк. Возвращаем её.
        return commonPrefix;
    }
};
